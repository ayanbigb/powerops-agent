# Copy this file to .env (cp .env.example .env) and edit it. Never commit .env.
# Leave OPENAI_API_KEY empty to use only the deterministic, no-API demo mode.
OPENAI_API_KEY=

# Any OpenAI chat model that supports tool (function) calling.
OPENAI_MODEL=gpt-4o-mini

# Optional: any OpenAI-compatible endpoint. For Google Gemini use the two lines below (and a Gemini key above).
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-flash-latest

# Optional: fixed sampling temperature. Leave unset; some models reject this parameter.
# OPENAI_TEMPERATURE=0

# Optional: point at your own validation plan (path relative to the project folder).
# POWEROPS_PLAN_PATH=config/validation_plan.example.json

# Where the Streamlit UI finds the FastAPI backend.
POWEROPS_API_URL=http://127.0.0.1:8000
